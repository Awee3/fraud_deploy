    {
      "parameters": {
        "jsCode": "// Ambil waktu trigger dari node pertama\nconst triggerTime = $('Deployment Trigger').first().json.headers?.['x-github-delivery']\n  ? new Date().toISOString()  // fallback jika tidak ada timestamp\n  : new Date().toISOString();\n\n// Hitung lead time dari sekarang\n// (idealnya simpan start time di Set File Paths, tapi ini approximation)\n// Ambil start time yang sudah disimpan di Set File Paths\nconst startTime   = $('Set File Paths').first().json.deploy_start_time;\nconst modelName   = $('Set File Paths').first().json.model_name;\n\nconst leadTimeSec = (Date.now() - new Date(startTime).getTime()) / 1000;\n\nreturn [{\n  json: {\n    model_name:        modelName,\n    lead_time_seconds: parseFloat(leadTimeSec.toFixed(3)),\n    status:            'success',\n    triggered_by:      'github_webhook',\n    summary:           `✅ ${modelName} deployed dalam ${leadTimeSec.toFixed(1)} detik`\n  }\n}];"
      },
