    {
      "parameters": {
        "jsCode": "// Ambil semua commit dari webhook payload\nconst commits = items[0].json.body.commits;\n\n// Gabungkan semua file yang di-modified/added\nlet allFiles = [];\nfor (const commit of commits) {\n  allFiles = allFiles.concat(\n    commit.modified ?? [],\n    commit.added    ?? []\n  );\n}\n\n// Cari file .pkl pertama yang ditemukan\n// Ini dinamis — akan bekerja untuk rf_model.pkl, xgb_model.pkl, model_v2.pkl, dll.\nconst modelPath = allFiles.find(file => file.endsWith('.pkl'));\n\nif (!modelPath) {\n  throw new Error('Tidak ada file .pkl ditemukan di commit ini. Deployment dibatalkan.');\n}\n\n// Ambil nama file saja dari path\n// Contoh: \"models/rf_model_v2.pkl\" → \"rf_model_v2.pkl\"\nconst modelName = modelPath.split('/').pop();\n\nreturn [{\n  json: {\n    model_path:        modelPath,   // Path lengkap: \"models/rf_model_v2.pkl\"\n    model_name:        modelName,   // Nama file saja: \"rf_model_v2.pkl\"\n    deploy_start_time: new Date().toISOString(), // ✅ Untuk hitung lead time\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -64,
